#!/bin/bash

### PURPOSE
### 
### This script creates a .envrc file in the directory the user is currently in.
### It then populates it with the necessary lines to automatically activate the .venv directory (using direnv)
### when cd'ing into the directory


CWD=$(pwd)

write() {
	echo "$1" >> "$CWD/.envrc"
}

write "export VIRTUAL_ENV=$CWD/.venv"
write "PATH_add \"\$VIRTUAL_ENV/bin\""

direnv allow "$CWD"
