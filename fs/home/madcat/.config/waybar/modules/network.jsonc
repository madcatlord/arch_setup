{
	"network": {
		"intervall": 5,
		"format": "WIFI DISABLED",
		"format-ethernet": "󰈀",
		"format-disconnected": "󰤮",
		"format-wifi": "<span>{signalStrength}% {icon}</span>",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"tooltip-format-disconnected": "disconnected",
		"tooltip-format-ethernet": "{gwaddr}\nUp:\t{bandwidthUpBits}\nDown:\t{bandwidthDownBits}",
		"tooltip-format-wifi": "{essid}\n{gwaddr} at {frequency}GHz\nUp:\t{bandwidthUpBits}\nDown:\t{bandwidthDownBits}",
		"on-click": "~/.config/waybar/scripts/toggle-wifi.sh"
	}
}
